# Ignore everything by default
/*

# Allow website files
!index.html
!vercel.json
!.gitignore

# Allow the core portal files
!voyce_portal.html
!voyce_portal_data.json

# Allow the github/ deployment folder
!github/
!github/index.html
!github/voyce_portal_data.json
!github/README.md

# Python
.venv/
*.pyc
__pycache__/

